{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:demo": "node ../docs/test/scripts/generate_demo_camera_assets.mjs",
    "build": "vite build",
    "lint": "eslint src test tooling ../docs/test ../packages/contracts/src ../packages/contracts/test ../packages/control-domain/src",
    "test:node": "node --test",
    "test:browser": "node ../docs/test/scripts/run_browser_tests.mjs",
    "test:remote-smoke": "node --env-file=../backend/.env.test tooling/remoteBrowserSmoke.mjs",
    "test": "npm run test:node",
    "benchmark:grid": "node ../docs/test/scripts/benchmark_grid_chromium.mjs --output artifacts/stage6/benchmark-results.json",
    "benchmark:grid:check": "node ../docs/test/scripts/check_benchmark_grid.mjs artifacts/stage6/benchmark-results.json artifacts/stage6/quality-budgets.json",
    "evidence:check": "node ../docs/test/scripts/check_stage6_evidence.mjs",
    "evidence:stage7": "node ../docs/test/scripts/check_stage7_evidence.mjs",
    "evidence:stage8": "node ../docs/test/scripts/check_stage8_evidence.mjs",
    "verify:stage6": "npm run test:node && npm run test:browser && npm run lint && npm run build && npm run benchmark:grid && npm run benchmark:grid:check && npm run evidence:check",
    "verify:stage7": "npm run test:node && npm run test:browser && npm run lint && npm run build && npm run benchmark:grid && npm run evidence:stage7",
    "verify:stage8": "npm run verify:stage7 && npm run evidence:stage8",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@robot-hmi/contracts": "file:../packages/contracts",
    "@robot-hmi/control-domain": "file:../packages/control-domain",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "simplify-js": "^1.2.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
