NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
SESSION_SECRET=
ROBOT_ADAPTER=mock
CAMERA_MEDIA_MODE=demo
# CAMERA_MEDIA_MODE=ros only for the read-only camera integration.
# CAMERA_WHEP_BASE_URL=https://127.0.0.1:8889
DATA_DIR=/home/vistar/.local/share/robot-hmi/dev
TRUST_LOOPBACK_PROXY=false
# rosbridge của ROS 2 (đọc /odom, /cmd_out và phát /cmd_in trên cùng một kết nối).
# Bỏ trống = không nối ROS. Ví dụ: ws://192.168.1.10:9090 (rosbridge_websocket)
ROSBRIDGE_URL=
# Hiển thị /map (nav_msgs/OccupancyGrid) qua worker ROS 2 riêng.
ROS_MAP_ENABLED=false
ROS_MAP_SETUP=/opt/ros/jazzy/setup.bash
